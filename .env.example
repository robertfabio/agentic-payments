PORT=3001
JWT_SECRET=dev-secret
CORS_ORIGIN=http://localhost:5173
# Limite de gasto que um usuario novo recebe ao se registrar
LIMITE_PADRAO=1000
# Onde ficam os usuarios registrados (backend e mcp-server leem o mesmo arquivo)
USUARIOS_FILE=
# Opcional: grava o log de auditoria em JSONL neste caminho
AUDIT_LOG_FILE=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Modelos alternativos se o principal sair do ar (404/410/5xx)
NVIDIA_MODEL_FALLBACKS=openai/gpt-oss-20b,deepseek-ai/deepseek-v4-flash-0731

MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=tsx,../mcp-server/src/server.ts

VITE_API_URL=http://localhost:3001
